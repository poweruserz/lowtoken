{
  "description": "lowtoken: verified-lossless compression and deduplication of tool output",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" post 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" post",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" session 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
